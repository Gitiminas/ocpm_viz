  {
   "id": "pr:2385775323",
   "type": "pull_request",
   "attributes": [
    {
     "name": "title",
     "time": "1970-01-01T00:00:00Z",
     "value": "mcp: initial mpc work"
    },
    {
     "name": "base_ref",
     "time": "1970-01-01T00:00:00Z",
     "value": "main"
    },
    {
     "name": "head_ref",
     "time": "1970-01-01T00:00:00Z",
     "value": "connor4312/mcp-1"
    },
    {
     "name": "pr_number",
     "time": "1970-01-01T00:00:00Z",
     "value": 243221
    },
    {
     "name": "body_excerpt",
     "time": "1970-01-01T00:00:00Z",
     "value": "This adds initial support for MCP discovery and connections in VS Code.\n\n- It finds servers installed in claude_desktop_config as a demo, and also supports `.vscode/mcp.json`\n- This works for both local and remotes.\n- There is a command `MCP: List Servers` that allows listing and manually starting/stopping servers\n- When MCP servers are started, they can be used as tools in chat.\n\nGranular changes can be found in commits within this PR. Closes #242864, more issues will come under the `chat-mcp` "
    },
    {
     "name": "body_truncated",
     "time": "1970-01-01T00:00:00Z",
     "value": true
