# Copy to .env (gitignored) and fill in the two passwords. `docker compose` reads .env
# from the directory holding compose.yaml; every variable compose.yaml interpolates is
# declared here, and tests/docker-config.test.js fails when one is missing.

# ---- secrets: never committed ---------------------------------------------------------
# The superuser of the db container. Used by the init scripts and by the acceptance
# gates' psql connection; nothing in the request path connects as it.
POSTGRES_PASSWORD=change-me
# The role PostgREST logs in as (sql/postgrest_setup.sql, "The three roles").
AUTHENTICATOR_PASSWORD=change-me

# ---- the data --------------------------------------------------------------------------
# A directory-format pg_dump (`pg_dump -Fd`) of the database. Read once, on the first
# start against an empty volume; see docs/DOCKER.md. Defaults to ./dump, which is gitignored.
OCPM_DUMP_DIR=./dump
# Name of the database created in the container and restored into.
OCPM_DB_NAME=gharchive_ocpm_viz_wsl
# Parallel pg_restore jobs. More is faster up to the container's CPU count.
OCPM_RESTORE_JOBS=4

# ---- host ports, all bound to 127.0.0.1 ------------------------------------------------
# 5433 rather than 5432 so the stack can run beside a host PostgreSQL.
OCPM_DB_PORT=5433
# 3001 rather than 3000 so it can run beside a host PostgREST (ocpm.sh).
OCPM_API_PORT=3001
OCPM_WEB_PORT=8000
